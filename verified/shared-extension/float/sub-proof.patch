 #include "shim.h"
 float f32_sub(float a, float b) { return a - b; }
+/*@ assigns \nothing; ensures \forall integer i; 0<=i<4 ==> same_value(\result.lane[i],fp_sub32(a.lane[i],b.lane[i])); */
 float32x4_t vsubq_f32(float32x4_t a, float32x4_t b) {
   float32x4_t r = {{0}};
+  /*@ loop invariant 0<=i<=4;
+      loop invariant \forall integer j; 0<=j<i ==> same_value(r.lane[j],fp_sub32(a.lane[j],b.lane[j]));
