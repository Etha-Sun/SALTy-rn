#include "../../shim/rvv_model.h"

id : 1
priority : core(1)
left : CharArray::undef_seg(?p, ?lo, ?hi) at 0
right : undef_data_at(?q,char) at 1
check : infer(q == pointer_offset(p,lo,char));
        infer(lo < hi);
action : left_erase(0);
         right_erase(1);
         left_add(CharArray::undef_seg(p,lo+1,hi));

id : 2
priority : core(1)
left : CharArray::seg(?p, ?lo, ?hi, ?l) at 0
right : CharArray::seg(?q, ?lo2, ?hi2, ?r) at 1
check : infer(p == q);
        infer(lo == lo2);
        infer(hi == hi2);
action : left_erase(0);
         right_erase(1);
         right_add(l == r);

id : 3
priority : core(1)
left : CharArray::undef_seg(?p, ?lo, ?hi) at 0
right : CharArray::undef_seg(?q, ?lo2, ?hi2) at 1
check : infer(p == q);
        infer(lo == lo2);
        infer(hi == hi2);
action : left_erase(0);
         right_erase(1);

id : 4
priority : core(0)
left : CharArray::undef_full(?p, ?n) at 0
right : CharArray::undef_seg(?q,0,?m) at 1
check : infer(p == q);
        infer(n == m);
action : left_erase(0);
         right_erase(1);

id : 5
priority : core(0)
right : CharArray::seg(?p,0,0,s8_rvv_prefix(0,?l)) at 0
action : right_erase(0);
