"""Locate this case's pre-promotion artifacts without rewriting execution records."""
from pathlib import Path

CASE = Path(__file__).resolve().parent.parent
ROOT = next(p for p in CASE.parents if (p / '.git').exists())
OLD_CASE = ROOT / 'verification/qcp/candidates/f32-vlrelu'


def artifact_path(value):
    path = Path(value)
    try:
        return CASE / path.relative_to(OLD_CASE)
    except ValueError:
        return path
