#include "../../shim/model.h"
id : 1
priority : core(0)
left : FloatArray::undef_full(?p,?n) at 0
right : FloatArray::undef_full(?q,?m) at 1
check : infer(p == q);
        infer(n == m);
action : left_erase(0);
         right_erase(1);
id : 2
priority : core(0)
left : FloatArray::full(?p,?n,?l) at 0
right : FloatArray::full(?q,?m,?r) at 1
check : infer(p == q);
        infer(n == m);
action : left_erase(0);
         right_erase(1);
         right_add(l == r);
