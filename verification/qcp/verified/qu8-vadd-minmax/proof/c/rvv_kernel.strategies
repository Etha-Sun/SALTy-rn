#include "../../shim/rvv_memory.h"
id : 1
priority : core(0)
left : UCharArray::undef_full(?p,?n) at 0
right : UCharArray::undef_seg(?q,0,?m) at 1
check : infer(q == p);
        infer(0 <= m);
        infer(m <= n);
action : left_erase(0);
         right_erase(1);
         left_add(UCharArray::undef_full(pointer_offset(p,m,unsigned char),n-m));
