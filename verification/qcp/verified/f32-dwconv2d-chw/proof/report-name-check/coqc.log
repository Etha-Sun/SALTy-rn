dw_slide_up_active_window
     : forall (A B : BinNums.Z -> fp32) (prev : fp32) (x vl i : BinNums.Z),
       (forall k : BinNums.Z,
        BinInt.Z.le BinNums.Z0 k /\ BinInt.Z.lt k vl ->
        A k = B (BinInt.Z.add x k)) ->
       prev = B (BinInt.Z.sub x (BinNums.Zpos BinNums.xH)) ->
       BinInt.Z.le BinNums.Z0 i /\ BinInt.Z.lt i vl ->
       dw_rvv_slide_up A prev i =
       B (BinInt.Z.sub (BinInt.Z.add x i) (BinNums.Zpos BinNums.xH))
dw_slide_down_active_window
     : forall (A B : BinNums.Z -> fp32) (next : fp32) (x vl i : BinNums.Z),
       (forall k : BinNums.Z,
        BinInt.Z.le BinNums.Z0 k /\ BinInt.Z.lt k vl ->
        A k = B (BinInt.Z.add x k)) ->
       next = B (BinInt.Z.add x vl) ->
       BinInt.Z.le BinNums.Z0 i /\ BinInt.Z.lt i vl ->
       dw_rvv_slide_down A next vl i =
       B (BinInt.Z.add (BinInt.Z.add x i) (BinNums.Zpos BinNums.xH))
dw_vector_pixel_active_window
     : forall (F : DwROMap) (input zero weights H N y x : BinNums.Z)
         (A0 A1 A2 : BinNums.Z -> fp32)
         (prev0 prev1 prev2 next0 next1 next2 lo hi : fp32)
         (vl i : BinNums.Z),
       BinInt.Z.le BinNums.Z0 x ->
       BinInt.Z.le BinNums.Z0 vl /\
       BinInt.Z.le vl
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) ->
       BinInt.Z.le (BinInt.Z.add x vl) N ->
       BinInt.Z.le BinNums.Z0 i /\ BinInt.Z.lt i vl ->
       (forall k : BinNums.Z,
        BinInt.Z.le BinNums.Z0 k /\ BinInt.Z.lt k vl ->
        A0 k =
        dw_image F input zero H N (BinInt.Z.sub y (BinNums.Zpos BinNums.xH))
          (BinInt.Z.add x k)) ->
       (forall k : BinNums.Z,
        BinInt.Z.le BinNums.Z0 k /\ BinInt.Z.lt k vl ->
        A1 k = dw_image F input zero H N y (BinInt.Z.add x k)) ->
       (forall k : BinNums.Z,
        BinInt.Z.le BinNums.Z0 k /\ BinInt.Z.lt k vl ->
        A2 k =
        dw_image F input zero H N (BinInt.Z.add y (BinNums.Zpos BinNums.xH))
          (BinInt.Z.add x k)) ->
       prev0 =
       dw_image F input zero H N (BinInt.Z.sub y (BinNums.Zpos BinNums.xH))
         (BinInt.Z.sub x (BinNums.Zpos BinNums.xH)) ->
       prev1 =
       dw_image F input zero H N y (BinInt.Z.sub x (BinNums.Zpos BinNums.xH)) ->
       prev2 =
       dw_image F input zero H N (BinInt.Z.add y (BinNums.Zpos BinNums.xH))
         (BinInt.Z.sub x (BinNums.Zpos BinNums.xH)) ->
       next0 =
       dw_image F input zero H N (BinInt.Z.sub y (BinNums.Zpos BinNums.xH))
         (BinInt.Z.add x vl) ->
       next1 = dw_image F input zero H N y (BinInt.Z.add x vl) ->
       next2 =
       dw_image F input zero H N (BinInt.Z.add y (BinNums.Zpos BinNums.xH))
         (BinInt.Z.add x vl) ->
       dw_vector_pixel F weights A0 A1 A2 prev0 prev1 prev2 next0 next1 next2
         lo hi vl i =
       dw_pixel_rvv F input zero weights H N y (BinInt.Z.add x i) lo hi
dw_vector_match8_active_ext
     : forall (vl : BinNums.Z) (r0 r1 r2 r3 r4 r5 r6 r7 : fp32)
         (G K : BinNums.Z -> fp32),
       dw_vector_match8 vl r0 r1 r2 r3 r4 r5 r6 r7 G ->
       (forall i : BinNums.Z,
        BinInt.Z.le BinNums.Z0 i /\ BinInt.Z.lt i vl -> G i = K i) ->
       dw_vector_match8 vl r0 r1 r2 r3 r4 r5 r6 r7 K
