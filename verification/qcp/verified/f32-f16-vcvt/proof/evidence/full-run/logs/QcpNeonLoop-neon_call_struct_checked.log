Classical_Prop.classic : forall P : Prop, P \/ ~ P
RE_addr_of_congr :
  Morphisms.Proper (Morphisms.respectful lvalue_expr_equiv rvalue_expr_equiv)
    RE_addr_of
LE_arrow_field_congr :
  Morphisms.Proper
    (Morphisms.respectful rvalue_expr_equiv
       (Morphisms.respectful eq lvalue_expr_equiv)) LE_arrow_field
