sizeof_alias_type : String.string -> Z
ClassicalDedekindReals.sig_not_dec : forall P : Prop, {~ ~ P} + {~ P}
ClassicalDedekindReals.sig_forall_dec :
  forall P : nat -> Prop,
  (forall n : nat, {P n} + {~ P n}) ->
  {n : nat | ~ P n} + {forall n : nat, P n}
rvalue_expr_equiv : rvalue_expr -> rvalue_expr -> Prop
FunctionalExtensionality.functional_extensionality_dep :
  forall (A : Type) (B : A -> Type) (f g : forall x : A, B x),
  (forall x : A, f x = g x) -> f = g
eval_addr_expr_congr :
  Morphisms.Proper (Morphisms.respectful rvalue_expr_equiv eq) eval_addr_expr
eval_addr_expr : rvalue_expr -> addr
eval_addr :
  forall (R : rvalue_expr) (t : front_end_type),
