#include "../../shim/types_def.h"
#include "../../shim/ushort_array_def.h"

id : 1
priority : core(1)
left : UShortArray::undef_seg(?p, ?lo, ?hi) at 0
right : undef_data_at(?q,uint16_t) at 1
check : infer(q == p+2*lo);
        infer(lo < hi);
action : left_erase(0);
         right_erase(1);
         left_add(UShortArray::undef_seg(p,lo+1,hi));

id : 2
priority : core(1)
left : UShortArray::seg(?p, ?lo, ?hi, ?l) at 0
right : UShortArray::seg(?q, ?lo2, ?hi2, ?r) at 1
check : infer(p == q);
        infer(lo == lo2);
        infer(hi == hi2);
action : left_erase(0);
         right_erase(1);
         right_add(l == r);

id : 3
priority : core(1)
left : UShortArray::undef_seg(?p, ?lo, ?hi) at 0
right : UShortArray::undef_seg(?q, ?lo2, ?hi2) at 1
check : infer(p == q);
        infer(lo == lo2);
        infer(hi == hi2);
action : left_erase(0);
         right_erase(1);

id : 4
priority : core(0)
left : UShortArray::undef_full(?p, ?n) at 0
right : UShortArray::undef_seg(?q,0,?m) at 1
check : infer(p == q);
        infer(n == m);
action : left_erase(0);
         right_erase(1);

id : 5
priority : core(0)
right : UShortArray::seg(?p,0,0,f16_take(0,?l)) at 0
action : right_erase(0);
