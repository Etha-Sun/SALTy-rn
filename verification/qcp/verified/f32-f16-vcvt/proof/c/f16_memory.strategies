#include "../../shim/program_model.h"
id : 1
priority : core(0)
right : UShortArray::full(?p,?n,f16_values(?count,?a)) at 0
check : infer(n == 0);
        infer(count == 0);
action : right_erase(0);

id : 2
priority : core(0)
right : UShortArray::seg(?p,?lo,?hi,f16_rvv_values(?count,?a)) at 0
check : infer(lo == 0);
        infer(hi == 0);
        infer(count == 0);
action : right_erase(0);

id : 3
priority : core(0)
left : store(?p,float,?x) at 0
right : store(p,float,x) at 1
action : left_erase(0);
         right_erase(1);

id : 4
priority : core(0)
left : store(?p : Z,?ty,?x : Z) at 0
right : store(p,ty,x) at 1
action : left_erase(0);
         right_erase(1);
