#include "../../shim/array_model.h"
id : 1
priority : core(0)
left : CharArray::undef_full(?p,?n) at 0
right : CharArray::undef_full(?q,?r) at 1
check : infer(p == q);
        infer(0 <= r);
        infer(r <= n);
action : left_erase(0);
         right_erase(1);
         left_add(CharArray::undef_full(pointer_offset(p,r,char),n-r));
