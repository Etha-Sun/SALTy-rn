all_dimensions_canonical_models_match
     : forall (mr nc k : BinNums.Z) (a w : list fp32) (lo hi : fp32),
       repaired_rvv_matrix_using canonical_qnan mr nc k a w lo hi =
       neon_matrix mr nc k a w lo hi
all_dimensions_any_nan_models_observed
     : forall
         (replacement : Binary.binary_float
                          (BinNums.Zpos
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO (BinNums.xI BinNums.xH)))))
                          (BinNums.Zpos
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO BinNums.xH)))))))))
         (mr nc k : BinNums.Z) (a w : list fp32) (lo hi : fp32),
       Binary.is_nan
         (BinNums.Zpos
            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))
         (BinNums.Zpos
            (BinNums.xO
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         replacement = true ->
       List.Forall2 numeric_or_both_nan
         (repaired_rvv_matrix_using replacement mr nc k a w lo hi)
         (neon_matrix mr nc k a w lo hi)
full_domain_operand_indices_in_bounds
     : forall mr nc k row col depth : BinNums.Z,
       BinInt.Z.le (BinNums.Zpos BinNums.xH) mr /\
       BinInt.Z.le mr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) ->
       BinInt.Z.lt BinNums.Z0 nc ->
       BinInt.Z.lt BinNums.Z0 k ->
       BinInt.Z.le BinNums.Z0 row /\ BinInt.Z.lt row mr ->
       BinInt.Z.le BinNums.Z0 col /\ BinInt.Z.lt col nc ->
       BinInt.Z.le BinNums.Z0 depth /\ BinInt.Z.lt depth k ->
       (BinInt.Z.le BinNums.Z0 (BinInt.Z.add (BinInt.Z.mul row k) depth) /\
        BinInt.Z.lt (BinInt.Z.add (BinInt.Z.mul row k) depth)
          (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) k)) /\
       (BinInt.Z.le BinNums.Z0 (ScheduleBridge.bias_index k col) /\
        BinInt.Z.lt (ScheduleBridge.bias_index k col)
          (BinInt.Z.mul
             (BinInt.Z.mul (ScheduleBridge.blocks nc)
                (BinInt.Z.add k (BinNums.Zpos BinNums.xH)))
             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) /\
       BinInt.Z.le BinNums.Z0 (ScheduleBridge.weight_index k col depth) /\
       BinInt.Z.lt (ScheduleBridge.weight_index k col depth)
         (BinInt.Z.mul
            (BinInt.Z.mul (ScheduleBridge.blocks nc)
               (BinInt.Z.add k (BinNums.Zpos BinNums.xH)))
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
fulln_acc_finishes_at_neon_cell
     : forall (k row col : BinNums.Z) (a w : list fp32) (lo hi : fp32),
       neon_clamp (fulln_acc k k row col a w) lo hi =
       neon_cell k row col a w lo hi
full_cell_is_neon_cell
     : forall (k row col : BinNums.Z) (a w : list fp32) (lo hi : fp32),
       full_cell a w k row col lo hi = neon_cell k row col a w lo hi
initial_output_state
     : forall (c : addr) (mr nc k : BinNums.Z) (A W : list fp32)
         (lo hi : fp32),
       BinInt.Z.le BinNums.Z0 nc ->
       Snaive_C_Rules64.derivable1
         (Snaive_C_Rules64.FloatArray.undef_full c
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
               nc)) (output_state c mr nc k BinNums.Z0 A W lo hi)
completed_output_state
     : forall (c mr nc k : BinNums.Z) (A W : list fp32) (lo hi : fp32),
       BinInt.Z.le (BinNums.Zpos BinNums.xH) mr /\
       BinInt.Z.le mr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) ->
       BinInt.Z.le BinNums.Z0 nc ->
       Snaive_C_Rules64.derivable1 (output_state c mr nc k nc A W lo hi)
         (Snaive_C_Rules64.sepcon
            (Snaive_C_Rules64.FloatArray.full c (BinInt.Z.mul mr nc)
               (completed_values A W k mr nc lo hi))
            (Snaive_C_Rules64.FloatArray.undef_seg c 
               (BinInt.Z.mul mr nc)
               (BinInt.Z.mul
                  (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) nc)))
two_completed_output_states
     : forall (left right mr nc k : BinNums.Z) (a w : list fp32)
         (lo hi : fp32),
       BinInt.Z.le (BinNums.Zpos BinNums.xH) mr /\
       BinInt.Z.le mr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) ->
       BinInt.Z.le BinNums.Z0 nc ->
       Snaive_C_Rules64.derivable1
         (Snaive_C_Rules64.sepcon (output_state left mr nc k nc a w lo hi)
            (output_state right mr nc k nc a w lo hi))
         (Snaive_C_Rules64.andp
            (Snaive_C_Rules64.coq_prop
               (ComparatorLogic.outputs_related
                  (completed_values a w k mr nc lo hi)
                  (completed_values a w k mr nc lo hi)))
            (Snaive_C_Rules64.sepcon
               (Snaive_C_Rules64.sepcon
                  (Snaive_C_Rules64.sepcon
                     (Snaive_C_Rules64.FloatArray.full left
                        (BinInt.Z.mul mr nc)
                        (completed_values a w k mr nc lo hi))
                     (Snaive_C_Rules64.FloatArray.undef_seg left
                        (BinInt.Z.mul mr nc)
                        (BinInt.Z.mul
                           (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                           nc)))
                  (Snaive_C_Rules64.FloatArray.full right
                     (BinInt.Z.mul mr nc)
                     (completed_values a w k mr nc lo hi)))
               (Snaive_C_Rules64.FloatArray.undef_seg right
                  (BinInt.Z.mul mr nc)
                  (BinInt.Z.mul
                     (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) nc))))
caller_pre_to_neon_body_pre
     : forall (mr nc kc a ast w c cm cn params : BinNums.Z) 
         (A W : list fp32) (lo hi : fp32) (frame : Snaive_C_Rules64.expr),
       Snaive_C_Rules64.derivable1
         (CallerPre mr nc kc a ast w c cm cn params A W lo hi frame)
         (NeonBodyPre mr nc kc a ast w c cm cn params A W lo hi frame)
neon_body_post_to_caller_post
     : forall (mr nc kc a ast w c cm cn params : BinNums.Z) 
         (A W : list fp32) (lo hi : fp32) (frame : Snaive_C_Rules64.expr),
       CallerPure mr nc kc a ast w c cm cn params ->
       Snaive_C_Rules64.derivable1
         (NeonBodyPost mr nc kc a w c params A W lo hi frame)
         (CallerPost mr nc kc a w c params A W lo hi frame)
caller_pre_to_rvv_body_pre
     : forall (mr nc kc a ast w c cm cn params : BinNums.Z) 
         (A W : list fp32) (lo hi : fp32) (frame : Snaive_C_Rules64.expr),
       Snaive_C_Rules64.derivable1
         (CallerPre mr nc kc a ast w c cm cn params A W lo hi frame)
         (RvvBodyPre mr nc kc a ast w c cm cn params A W lo hi frame)
rvv_body_post_to_caller_post
     : forall (mr nc kc : BinNums.Z) (a w : addr) 
         (c params : BinNums.Z) (A W : list fp32) 
         (lo hi : fp32) (frame : Snaive_C_Rules64.expr),
       Snaive_C_Rules64.derivable1
         (RvvBodyPost mr nc kc a w c params A W lo hi frame)
         (CallerPost mr nc kc a w c params A W lo hi frame)
