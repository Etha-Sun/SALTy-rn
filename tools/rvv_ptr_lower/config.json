  "target_flags": ["-target", "riscv64-unknown-linux-musl", "-march=rv64gcv_zvfh", "-std=gnu99"],
  "profiles": {
    "xnn": ["stdint.h", "stddef.h", "assert.h", "math.h", "riscv_vector.h",
            "src/xnnpack/common.h", "src/xnnpack/math.h", "src/xnnpack/microparams.h"],
    "self": ["stdint.h", "stddef.h", "assert.h", "math.h", "riscv_vector.h",
