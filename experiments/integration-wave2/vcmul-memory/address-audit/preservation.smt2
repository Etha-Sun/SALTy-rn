(set-logic ALL)
(declare-sort Addr 0)
(declare-const null Addr)
(declare-fun int_of_addr (Addr) Int)
(declare-fun addr_of_int (Int) Addr)
; Stronger inverse than the production static-allocation-guarded inverse.
(assert (forall ((p Addr)) (= (addr_of_int (int_of_addr p)) p)))
(assert (= (int_of_addr null) 0))
(define-fun pi ((x Int)) Int (ite (= x 5) 9 (ite (= x 9) 5 x)))
(define-fun new_int ((p Addr)) Int (pi (int_of_addr p)))
(define-fun new_addr ((i Int)) Addr (addr_of_int (pi i)))
(declare-const arbitrary Addr)
(push)
(assert (not (= (new_addr (new_int arbitrary)) arbitrary)))
(check-sat)
(pop)
(push)
(assert (not (= (new_int null) 0)))
(check-sat)
(pop)
