;; "P_same_value"
(define-fun P_same_value ((a Float32) (b Float32)) Bool
  (or (fp.eq a b) (and (fp.isNaN a) (fp.isNaN b))))

;; "P_same_float"
(define-fun P_same_float ((a Float32) (b Float32)) Bool
  (or
    (and (fp.isNaN a) (fp.isNaN b))
    (and (= (sign_f32 b) (sign_f32 a)) (P_same_value a b))))

;; "Q_same_float_value"
(assert
  (forall ((a Float32) (b Float32))
    (=> (P_same_float a b) (P_same_value a b))))

