module CintMods
  use int.Int
  use int.EuclideanDivision as ED
  use frama_c_wp.cint.Cint

  let rec lemma uint16_mod (x:int)
    ensures { to_uint16 x = ED.mod x 65536 }
    variant { if x < 0 then 65536-x else x }
  = if x < 0 then uint16_mod (x+65536)
    else if x >= 65536 then uint16_mod (x-65536)
    else ()

  let rec lemma sint16_mod (x:int)
    ensures { to_sint16 x =
      if ED.mod x 65536 < 32768 then ED.mod x 65536
      else ED.mod x 65536-65536 }
    variant { if x < -32768 then 32768-x else x-32768 }
  = if x < -32768 then sint16_mod (x+65536)
    else if x >= 32768 then sint16_mod (x-65536)
    else ()

  let rec lemma uint32_mod (x:int)
    ensures { to_uint32 x = ED.mod x 4294967296 }
    variant { if x < 0 then 4294967296-x else x }
  = if x < 0 then uint32_mod (x+4294967296)
    else if x >= 4294967296 then uint32_mod (x-4294967296)
    else ()

  let rec lemma sint32_mod (x:int)
    ensures { to_sint32 x =
      if ED.mod x 4294967296 < 2147483648 then ED.mod x 4294967296
      else ED.mod x 4294967296-4294967296 }
    variant { if x < -2147483648 then 2147483648-x else x-2147483648 }
  = if x < -2147483648 then sint32_mod (x+4294967296)
    else if x >= 2147483648 then sint32_mod (x-4294967296)
    else ()

  let rec lemma uint64_mod (x:int)
    ensures { to_uint64 x = ED.mod x 18446744073709551616 }
    variant { if x < 0 then 18446744073709551616-x else x }
  = if x < 0 then uint64_mod (x+18446744073709551616)
    else if x >= 18446744073709551616 then uint64_mod (x-18446744073709551616)
    else ()

  let rec lemma sint64_mod (x:int)
    ensures { to_sint64 x =
      if ED.mod x 18446744073709551616 < 9223372036854775808 then ED.mod x 18446744073709551616
      else ED.mod x 18446744073709551616-18446744073709551616 }
    variant { if x < -9223372036854775808 then 9223372036854775808-x else x-9223372036854775808 }
  = if x < -9223372036854775808 then sint64_mod (x+18446744073709551616)
    else if x >= 9223372036854775808 then sint64_mod (x-18446744073709551616)
    else ()

  function wrap16 (x:int) : int =
    if to_uint16 x <= 32767 then to_uint16 x else to_uint16 x-65536

  let lemma centered_mod16 (x z:int)
    ensures {
      wrap16 (to_uint64 (to_sint16 (-z)+x)) =
      wrap16 (to_uint64 (to_uint64 x-to_uint64 (to_sint16 z))) }
  = sint16_mod z;
    sint16_mod (-z);
    uint64_mod x;
    uint64_mod (to_sint16 z);
    uint64_mod (to_sint16 (-z)+x);
    uint64_mod (to_uint64 x-to_uint64 (to_sint16 z));
    uint16_mod (to_uint64 (to_sint16 (-z)+x));
    uint16_mod (to_uint64 (to_uint64 x-to_uint64 (to_sint16 z)));
    assert { ED.mod (to_sint16 (-z)+to_sint16 z) 65536=0 }
end
