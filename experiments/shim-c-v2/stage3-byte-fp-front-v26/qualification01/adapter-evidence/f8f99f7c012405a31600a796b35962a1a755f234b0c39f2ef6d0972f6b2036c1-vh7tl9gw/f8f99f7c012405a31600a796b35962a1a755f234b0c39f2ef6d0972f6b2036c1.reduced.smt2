  (forall ((a ty))
    (forall ((x uni))
      (=>
        (sort a x)
        (and
          (not (mem a x (Nil a)))
          (forall ((y uni) (r uni))
            (=>
              (sort a y)
              (= (mem a x (Cons a y r)) (or (= x y) (mem a x r))))))))))

;; "nth"
