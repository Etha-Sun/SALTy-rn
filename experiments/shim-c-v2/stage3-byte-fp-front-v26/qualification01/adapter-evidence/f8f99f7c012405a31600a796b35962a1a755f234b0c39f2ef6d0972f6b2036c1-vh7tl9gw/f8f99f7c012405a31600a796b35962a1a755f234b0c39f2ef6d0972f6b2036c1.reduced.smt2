  Int
  uni) uni)

;; "nth_sort"
(assert
  (forall ((a ty))
    (forall ((x Int) (x1 uni)) (sort (option a) (nth a x x1)))))

;; "nth'def"
(assert
  (forall ((a ty))
    (forall ((n Int))
      (and
        (= (nth a n (Nil a)) (None a))
        (forall ((x uni) (r uni))
          (let ((l (Cons a x r)))
            (ite (= n 0)
              (= (nth a n l) (Some a x))
              (= (nth a n l) (nth a (- n 1) r)))))))))

