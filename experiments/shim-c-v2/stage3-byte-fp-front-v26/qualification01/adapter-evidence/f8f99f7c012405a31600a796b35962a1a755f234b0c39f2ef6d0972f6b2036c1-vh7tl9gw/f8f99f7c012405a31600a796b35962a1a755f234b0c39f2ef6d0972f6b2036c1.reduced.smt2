  (forall ((a ty))
    (forall ((x uni) (l1 uni) (l2 uni))
      (= (num_occ a x (infix_plpl a l1 l2)) (+ (num_occ a x l1) (num_occ
                                                                  a
                                                                  x
                                                                  l2))))))

