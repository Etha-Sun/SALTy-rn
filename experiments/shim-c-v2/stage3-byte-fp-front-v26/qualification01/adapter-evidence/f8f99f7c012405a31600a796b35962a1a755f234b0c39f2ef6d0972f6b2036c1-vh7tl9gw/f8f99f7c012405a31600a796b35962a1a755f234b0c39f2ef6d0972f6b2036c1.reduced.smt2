  uni
  uni) Int)

;; "num_occ'def"
(assert
  (forall ((a ty))
    (forall ((x uni))
      (=>
        (sort a x)
        (and
          (= (num_occ a x (Nil a)) 0)
          (forall ((y uni) (r uni))
            (=>
              (sort a y)
              (= (num_occ a x (Cons a y r)) (+ (ite (= x y) 1 0) (num_occ
                                                                   a
                                                                   x
                                                                   r))))))))))

;; "Num_Occ_NonNeg"
