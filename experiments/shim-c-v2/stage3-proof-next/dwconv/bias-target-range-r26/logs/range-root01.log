    Have: (forall f : f32. (P_next_m4_bias(a_18, 0, f) -> P_ext_same(a_19, f))) /\
        (forall f : f32. (P_next_m4_bias(a_18, 1, f) -> P_ext_same(a_16, f))) /\
        (forall f : f32. (P_next_m4_bias(a_18, 2, f) -> P_ext_same(a_14, f))) /\
        (forall f : f32. (P_next_m4_bias(a_18, 3, f) -> P_ext_same(a_12, f))) /\
        (forall i_1 : Z. forall f : f32. ((0 <= i_1) -> ((i_1 <= 15) ->
         (P_next_m4_bias(a_18, i_1, f) ->
         P_ext_same(a_7[shift_float32(a_8, i_1)], f))))).
    (* Assertion 'next_prestate_loaded_lane1' *)
    Have: ((2 <= x) -> P_ext_same(a_16, a_17)).
    (* Assertion 'next_prestate_loaded_lane2' *)
    Have: ((3 <= x) -> P_ext_same(a_14, a_15)).
    (* Assertion 'next_prestate_loaded_lane3' *)
    Have: ((4 <= x) -> P_ext_same(a_12, a_13)).
    (* Initializer *)
    Init: Mint_1[a_11] = 0.
    (* Invariant 'next_lane_vl_range' *)
    Have: x <= 4.
    (* Invariant 'next_lane_bound' *)
    Have: (0 <= v_1) /\ (v_1 <= x).
    (* Invariant 'next_lane_prefix' *)
    Have: forall i_1 : Z. ((0 <= i_1) -> ((i_1 < v_1) ->
        P_ext_same(a_7[shift_float32(a_8, i_1)],
          a_5[shift_float32(a_9, i_1 + x_9)]))).
    (* Assertion 'next_lane_before_step' *)
    Have: v_1 <= 3.
    If v_1 = 1
    Then { (* Assertion 'next_case1' *) Have: P_ext_same(a_16, a_17). }
    Else {
      If v_1 = 2
      Then { (* Assertion 'next_case2' *) Have: P_ext_same(a_14, a_15). }
      Else {
        (* Assertion 'next_case3_index' *)
        Have: v_1 = 3.
        (* Assertion 'next_case3' *)
        Have: P_ext_same(a_12, a_13).
      }
    }
    (* Assertion 'next_lane_after_step' *)
    Have: x_1 = to_uint64(x_1).
    (* Invariant 'next_lane_bound' *)
    Have: v_1 < x.
  }
  Prove: P_ext_same(a_7[shift_float32(a_8, i)],
           a_5[shift_float32(a_9, i + x_9)]).
  
