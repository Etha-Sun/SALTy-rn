import "/srv/home/yuechunsun/tools/lean/build/shim-c/experiments/shim-c-v2/stage3-byte-fp-front-v1/z3-codec.drv"

theory nativebv.NativeBV
 syntax type b32 "(_ BitVec 32)"
 syntax function of_int32 "((_ int2bv 32) %1)"
 syntax function to_uint32 "(bv2int %1)"
 syntax function decode_bv32 "((_ to_fp 8 24) %1)"
 syntax function encode_bv32 "(ite (fp.isNaN %1) (bvor (bvand %2 #x80000000) (bvadd #x7f800000 (bvadd #x00000001 (bvurem (bvand %2 #x7fffffff) #x007fffff)))) (fp.to_ieee_bv %1))"
 syntax type b64 "(_ BitVec 64)"
 syntax function of_int64 "((_ int2bv 64) %1)"
 syntax function to_uint64 "(bv2int %1)"
 syntax function decode_bv64 "((_ to_fp 11 53) %1)"
 syntax function encode_bv64 "(ite (fp.isNaN %1) (bvor (bvand %2 #x8000000000000000) (bvadd #x7ff0000000000000 (bvadd #x0000000000000001 (bvurem (bvand %2 #x7fffffffffffffff) #x000fffffffffffff)))) (fp.to_ieee_bv %1))"
end
