;; "div"
(declare-fun div1 (Int
  Int) Int)

;; "mod"
(declare-fun mod1 (Int
  Int) Int)

;; "Div_mod"
(assert
  (forall ((x74 Int) (y2 Int))
    (=> (not (= y2 0)) (= x74 (+ (* y2 (div1 x74 y2)) (mod1 x74 y2))))))

;; "Div_bound"
(assert
  (forall ((x74 Int) (y2 Int))
    (=>
      (and (<= 0 x74) (< 0 y2))
      (and (<= 0 (div1 x74 y2)) (<= (div1 x74 y2) x74)))))

;; "Mod_bound"
(assert
  (forall ((x74 Int) (y2 Int))
    (=>
      (not (= y2 0))
      (and (< (- (abs1 y2)) (mod1 x74 y2)) (< (mod1 x74 y2) (abs1 y2))))))

;; "Div_sign_pos"
(assert
  (forall ((x74 Int) (y2 Int))
    (=> (and (<= 0 x74) (< 0 y2)) (<= 0 (div1 x74 y2)))))

;; "Div_sign_neg"
(assert
  (forall ((x74 Int) (y2 Int))
    (=> (and (<= x74 0) (< 0 y2)) (<= (div1 x74 y2) 0))))

;; "Mod_sign_pos"
(assert
  (forall ((x74 Int) (y2 Int))
    (=> (and (<= 0 x74) (not (= y2 0))) (<= 0 (mod1 x74 y2)))))

;; "Mod_sign_neg"
(assert
  (forall ((x74 Int) (y2 Int))
    (=> (and (<= x74 0) (not (= y2 0))) (<= (mod1 x74 y2) 0))))

;; "Rounds_toward_zero"
(assert
  (forall ((x74 Int) (y2 Int))
    (=> (not (= y2 0)) (<= (abs1 (* (div1 x74 y2) y2)) (abs1 x74)))))

;; "Div_1"
(assert (forall ((x74 Int)) (= (div1 x74 1) x74)))

;; "Mod_1"
(assert (forall ((x74 Int)) (= (mod1 x74 1) 0)))

;; "Div_inf"
(assert
  (forall ((x74 Int) (y2 Int))
    (=> (and (<= 0 x74) (< x74 y2)) (= (div1 x74 y2) 0))))

;; "Mod_inf"
(assert
  (forall ((x74 Int) (y2 Int))
    (=> (and (<= 0 x74) (< x74 y2)) (= (mod1 x74 y2) x74))))

;; "Div_mult"
(assert
  (forall ((x74 Int) (y2 Int) (z Int))
    (! (=>
         (and (< 0 x74) (and (<= 0 y2) (<= 0 z)))
         (= (div1 (+ (* x74 y2) z) x74) (+ y2 (div1 z x74)))) :pattern (
    (div1
      (+ (* x74 y2) z)
      x74)) )))

;; "Mod_mult"
