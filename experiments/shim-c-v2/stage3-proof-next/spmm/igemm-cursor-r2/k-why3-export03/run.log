     lane:int, t:int, k:int, p:int.
     0 < k ->
     0 <= t ->
     P_ext_same (L_stage3_iacc mptr mf32 a w block lane (1 + t) k p)
     (fma_f32
      (get mf32 (shift_float32 (get mptr (shift_PTR a (div t k))) (mod t k)))
      (get mf32
       (shift_float32 w
        (((8 + lane) + (8 * t)) + (block * (8 + (8 * (k * p)))))))
      (L_stage3_iacc mptr mf32 a w block lane t k p))
  
