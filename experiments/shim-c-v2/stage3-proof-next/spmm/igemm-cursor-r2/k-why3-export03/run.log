  (* use frama_c_wp.cfloat.Cfloat *)
  
  predicate P_ext_same (x:t) (y:t) =
    is_NaN_f32 x /\ is_NaN_f32 y \/ sign_f32 y = sign_f32 x /\ eq_f32 x y
  
  (* use frama_c_wp.memaddr.MemAddr *)
  
  (* use Compound *)
  
  (* use frama_c_wp.fma.Fma *)
  
  function L_stage3_iacc (addr -> addr) (addr -> t) addr addr int int int int
    int : t
  
  axiom L_stage3_iacc_def :
    forall mptr:addr -> addr, mf32:addr -> t, a:addr, w:addr, block:int,
     lane:int, t:int, k:int, p:int.
     L_stage3_iacc mptr mf32 a w block lane t k p =
     (let x = block * (8 + (8 * (k * p))) in
      let x1 = (- 1) + t in
      if t <= 0 then get mf32 (shift_float32 w (lane + x))
      else fma_f32
           (get mf32
            (shift_float32 (get mptr (shift_PTR a (div x1 k))) (mod x1 k)))
           (get mf32 (shift_float32 w ((lane + (8 * t)) + x)))
           (L_stage3_iacc mptr mf32 a w block lane x1 k p))
  
  function L_ext_num_max32 (a:t) (b:t) : t =
    if is_NaN_f32 a then if is_NaN_f32 b then a else b
    else if is_NaN_f32 b then a
         else if lt_f32 b a then a
              else if lt_f32 a b then b
                   else if sign_f32 a = Positive then a else b
  
  function L_ext_neon_max32 (a:t) (b:t) : t =
    if is_NaN_f32 a then a
    else if is_NaN_f32 b then b else L_ext_num_max32 a b
  
  function L_ext_num_min32 (a:t) (b:t) : t =
    if is_NaN_f32 a then if is_NaN_f32 b then a else b
    else if is_NaN_f32 b then a
         else if lt_f32 a b then a
              else if lt_f32 b a then b
                   else if sign_f32 a = Negative then a else b
  
  function L_ext_neon_min32 (a:t) (b:t) : t =
    if is_NaN_f32 a then a
