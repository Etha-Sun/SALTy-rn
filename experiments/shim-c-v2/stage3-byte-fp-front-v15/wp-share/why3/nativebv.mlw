theory NativeBV
  use int.Int
  use frama_c_wp.cfloat.Cfloat
  type b32
  function of_int32 int : b32
  function to_uint32 b32 : int
  function decode_bv32 b32 : f32
  function encode_bv32 f32 b32 : b32
  type b64
  function of_int64 int : b64
  function to_uint64 b64 : int
  function decode_bv64 b64 : f64
  function encode_bv64 f64 b64 : b64
end
