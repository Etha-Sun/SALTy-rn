+/*@ requires vl<=32; assigns \nothing; ensures \forall integer i; 0<=i<vl ==> same_float(\result.lane[i],mask.lane[i]?b.lane[i]:a.lane[i]); */
 vfloat32m8_t __riscv_vmerge_vvm_f32m8(vfloat32m8_t a,vfloat32m8_t b,vbool4_t mask,size_t vl) {
   vfloat32m8_t r={{0}};
+  /*@ loop invariant 0<=i<=vl; loop invariant \forall integer j; 0<=j<i ==> same_float(r.lane[j],mask.lane[j]?b.lane[j]:a.lane[j]); loop assigns i,r.lane[0..31]; loop variant vl-i; */
   for(size_t i=0;i<vl;i++) r.lane[i]=mask.lane[i]?b.lane[i]:a.lane[i];
