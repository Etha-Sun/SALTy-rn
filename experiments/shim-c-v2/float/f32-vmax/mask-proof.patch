 #include "shim.h"
+/*@ requires vl<=32; assigns \nothing; ensures \forall integer i; 0<=i<vl ==> (\result.lane[i] <==> !\eq_float(a.lane[i],b.lane[i])); */
 vbool4_t __riscv_vmfne_vv_f32m8_b4(vfloat32m8_t a,vfloat32m8_t b,size_t vl) {
   vbool4_t r={{0}};
+  /*@ loop invariant 0<=i<=vl; loop invariant \forall integer j; 0<=j<i ==> (r.lane[j] <==> !\eq_float(a.lane[j],b.lane[j])); loop assigns i,r.lane[0..31]; loop variant vl-i; */
   for(size_t i=0;i<vl;i++) r.lane[i]=a.lane[i]!=b.lane[i];
