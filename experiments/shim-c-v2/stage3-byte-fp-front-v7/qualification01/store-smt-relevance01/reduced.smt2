;; "checked_store_read32"
(assert
  (forall ((m (Array Int (Array Int Int))) (a addr) (v Float32) (seed Int))
    (= ((_ to_fp 8 24) ((_ int2bv 32) (read_uint32
                                        (write_uint32
                                          m
                                          a
                                          (bv2int (ite (fp.isNaN v) (bvor (bvand ((_ int2bv 32) seed) #x80000000) (bvadd #x7f800000 (bvadd #x00000001 (bvurem (bvand ((_ int2bv 32) seed) #x7fffffff) #x007fffff)))) (fp.to_ieee_bv v))))
                                        a))) v)))

;; "P_same32"
(declare-fun P_same32 (Float32
  Float32) Bool)

;; "P_same32'def"
(assert
  (forall ((x Float32) (y Float32))
    (= (P_same32 x y) (or (fp.eq x y) (and (fp.isNaN x) (fp.isNaN y))))))

;; Goal "wp_goal"
(assert
  (not
  (forall ((t2 (Array Int Int)) (t3 (Array Int (Array Int Int))) (i Int) (a addr) (f Float32))
    (let ((m (write_uint32
               t3
               a
               (bv2int (ite (fp.isNaN f) (bvor (bvand ((_ int2bv 32) i) #x80000000) (bvadd #x7f800000 (bvadd #x00000001 (bvurem (bvand ((_ int2bv 32) i) #x7fffffff) #x007fffff)))) (fp.to_ieee_bv f))))))
      (=>
        (<= (region (base a)) 0)
        (=>
          (framed t3)
          (=>
            (linked t2)
            (=>
              (sconst t3)
              (=>
                (bytes t3)
                (=>
                  (valid_rw t2 a 4)
                  (=>
                    (bytes m)
                    (P_same32
                      ((_ to_fp 8 24) ((_ int2bv 32) (read_uint32 m a)))
                      f))))))))))))

(check-sat)
