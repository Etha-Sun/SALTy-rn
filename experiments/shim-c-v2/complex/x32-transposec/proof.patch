     while (bh > 0) {
       vuint32m8_t v = __riscv_vle32_v_u32m8(i, vl);
       __riscv_vsse32_v_u32m8(o, output_stride, v, vl);
       
       i = (const uint32_t*) ((uintptr_t) i + input_stride);
+      /*@ assert i==src0+(W-bw)+(H-bh+1)*IS; */
       o += 1;
       bh -= 1;
     }
