 inline RVVVector __riscv_vfsub_vv_f64m8(const RVVVector& a, const RVVVector& b, size_t vl){ return _gfa_vv(a,b,64,G_SUB,vl); }
 
+
+inline RVVVector __riscv_vfadd_vv_f32m8_rm(const RVVVector& a, const RVVVector& b, unsigned frm, size_t vl) {
+    ScopedRVVRounding rounding(frm);
+    return _gfa_vv(a, b, 32, G_ADD, vl);
+}
+inline RVVVector __riscv_vfsub_vv_f32m8_rm(const RVVVector& a, const RVVVector& b, unsigned frm, size_t vl) {
+    ScopedRVVRounding rounding(frm);
+    return _gfa_vv(a, b, 32, G_SUB, vl);
+}
+inline RVVVector __riscv_vfmul_vv_f32m8_rm(const RVVVector& a, const RVVVector& b, unsigned frm, size_t vl) {
+    ScopedRVVRounding rounding(frm);
+    return _gfa_vv(a, b, 32, G_MUL, vl);
+}
 } // namespace salt_cvc5
