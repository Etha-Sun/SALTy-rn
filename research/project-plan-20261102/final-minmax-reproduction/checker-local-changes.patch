 namespace salt_cvc5 {
 
+// Explicit rounding changes the operation's RM, then restores the dynamic RM.
+// Reuse the checked FRM decoder: reserved/DYN encodings remain unsupported.
+class ScopedRVVRounding {
+    Term previous;
+public:
+    explicit ScopedRVVRounding(unsigned frm) : previous(g_ctx->fp.rounding_mode) {
+        g_ctx->fp.rounding_mode = rm_term_from_frm(g_ctx->tm, frm);
+    }
+    ~ScopedRVVRounding() { g_ctx->fp.rounding_mode = previous; }
+};
+
