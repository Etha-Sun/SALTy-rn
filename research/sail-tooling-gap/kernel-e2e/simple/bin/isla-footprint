#!/usr/bin/env bash
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
case "$1" in
 aarch64.ir) snapshot="/srv/home/yuechunsun/tools/lean/research/sail-tooling-gap/vendor/islaris-pinned-aarch64.ir" ;;
